<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon (S13.3, ID-6 = S2; concept approved in S13.1):
     the orbit is drawn (0-300 ms), the inner orbit follows (60-320 ms), the
     ice-blue star arrives at the opening (140-380 ms). Compressed from the
     approved 720 ms storyboard after the phone showed the splash removed at
     about 300-350 ms, before the star arrived (S13.3). Ends on the static
     icon (ic_launcher_foreground.xml, same geometry). No start delay; the
     system shows the end state when animations are off, and removes the
     splash at the app's first frame, so it never delays startup. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:name="inner"
                android:pathData="M53.06,40.83 A13.2,13.2 0 1 0 66.8,57.21"
                android:strokeWidth="2.4"
                android:strokeColor="#7F8DC0"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="outer"
                android:pathData="M60.77,33.07 A22,22 0 1 0 75.79,50.96"
                android:strokeWidth="6"
                android:strokeColor="#E6EBF7"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="star"
                android:pivotX="70.85"
                android:pivotY="39.86"
                android:rotation="-45"
                android:scaleX="0.4"
                android:scaleY="0.4">
                <path
                    android:name="starFill"
                    android:fillAlpha="0"
                    android:fillColor="#8CCBFF"
                    android:pathData="M70.85,30.26 Q72.39,38.32 80.45,39.86 Q72.39,41.39 70.85,49.46 Q69.32,41.39 61.25,39.86 Q69.32,38.32 70.85,30.26 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="outer">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="inner">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="60"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="star">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="140"
                    android:valueFrom="0.4"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="140"
                    android:valueFrom="0.4"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="140"
                    android:valueFrom="-45"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="starFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="80"
                android:propertyName="fillAlpha"
                android:startOffset="140"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
