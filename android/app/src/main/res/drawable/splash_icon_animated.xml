<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon (S13.3, ID-6 as amended by the owner on
     2026-10-17): a one-second, smooth sequence. The orbit is drawn
     (0-650 ms), the inner orbit follows (150-750 ms), the ice-blue star
     settles into the opening (500-1000 ms). Ends on the static icon
     (ic_launcher_foreground.xml, same geometry). MainActivity keeps the
     splash until this sequence ends, then fades it out; with animations off
     the end state is shown and nothing is held. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:name="inner"
                android:pathData="M53.06,40.83 A13.2,13.2 0 1 0 66.8,57.21"
                android:strokeWidth="2.4"
                android:strokeColor="#7F8DC0"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <path
                android:name="outer"
                android:pathData="M60.77,33.07 A22,22 0 1 0 75.79,50.96"
                android:strokeWidth="6"
                android:strokeColor="#E6EBF7"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="star"
                android:pivotX="70.85"
                android:pivotY="39.86"
                android:rotation="-30"
                android:scaleX="0.5"
                android:scaleY="0.5">
                <path
                    android:name="starFill"
                    android:fillAlpha="0"
                    android:fillColor="#8CCBFF"
                    android:pathData="M70.85,30.26 Q72.39,38.32 80.45,39.86 Q72.39,41.39 70.85,49.46 Q69.32,41.39 61.25,39.86 Q69.32,38.32 70.85,30.26 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="outer">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="inner">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="600"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="150"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="star">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleX"
                    android:startOffset="500"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="scaleY"
                    android:startOffset="500"
                    android:valueFrom="0.5"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="500"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:startOffset="500"
                    android:valueFrom="-30"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="starFill">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="250"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="fillAlpha"
                android:startOffset="500"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
