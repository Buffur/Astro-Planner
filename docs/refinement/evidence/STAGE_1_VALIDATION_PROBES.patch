+    test('validation: background refusal remains typed for v$version', () async {
+      final dir = Directory.systemTemp.createTempSync('astroplan_s1_background_');
+      final file = File(p.join(dir.path, 'astroplan.sqlite'));
+      await _stamp(file, version);
+      final before = file.readAsBytesSync();
+      final db = AppDatabase(LazyDatabase(() async => NativeDatabase.createInBackground(file)));
+      Object? error;
+      UnsupportedSchemaVersionException? refused;
+      try {
+        refused = await refusedSchemaVersion(db);
+      } catch (e) {
+        error = e;
+      } finally {
+        await db.close();
+      }
+      final unchanged = file.readAsBytesSync().toString() == before.toString();
+      dir.deleteSync(recursive: true);
+      expect(unchanged, isTrue);
+      expect(error?.runtimeType.toString(), isNull,
+          reason: 'the production connection must return a typed refusal');
+      expect(refused?.foundVersion, version);
+    });
+  }
